# Copy this file to ".env" and fill it in.

BRAND=My Studio
# Long password for the /admin page (20+ characters)
ADMIN_PASSWORD=

# --- Mail id that sends the OTP -------------------------------------------
# Gmail / Google Workspace: turn on 2-Step Verification, then create an
# "App password" at https://myaccount.google.com/apppasswords and paste it below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourname@gmail.com
SMTP_PASSWORD=
MAIL_FROM=yourname@gmail.com
# Office 365 instead: SMTP_HOST=smtp.office365.com  SMTP_PORT=587

# --- Options ---------------------------------------------------------------
# 1 only while testing on your own computer (OTP shows in the server window,
# works without https). MUST be 0 for real guests.
DEV_MODE=0
# 1 when the app sits behind Caddy / Nginx / Cloudflare Tunnel (recommended)
TRUST_PROXY=0
# Higher = stricter face match (fewer wrong photos, may miss some). 0.36-0.45
MATCH_THRESHOLD=0.40
SESSION_HOURS=2
