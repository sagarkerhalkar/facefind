# Copy this file to ".env" and fill it in.

BRAND=My Studio
# Long password for the /admin page (20+ characters)
ADMIN_PASSWORD=

# --- Mail id that sends the OTP -------------------------------------------
# Gmail / Google Workspace: turn on 2-Step Verification, then create an
# "App password" at https://myaccount.google.com/apppasswords and paste it below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourname@gmail.com
SMTP_PASSWORD=
MAIL_FROM=yourname@gmail.com
# Office 365 instead: SMTP_HOST=smtp.office365.com  SMTP_PORT=587

# --- Network ---------------------------------------------------------------
# 0.0.0.0 = every device on your LAN can open it. 127.0.0.1 = this computer only.
HOST=0.0.0.0
# First port to try. If it is busy the app takes the next free one by itself
# and prints the address in the window.
PORT=8443
# 1 = built-in HTTPS for the LAN (the certificate is made automatically).
# Set 0 only when a domain / reverse proxy in front provides HTTPS.
HTTPS=1
# Which networks / VLANs may open the app (empty = any). Example:
# ALLOWED_NETWORKS=192.168.10.0/24,192.168.20.0/24
ALLOWED_NETWORKS=
# Which networks may open /admin (empty = same as above). Example: office VLAN only
# ADMIN_NETWORKS=192.168.10.0/24
ADMIN_NETWORKS=
# Later, when you host it on a domain: guest links will use this address.
# PUBLIC_URL=https://photos.yourdomain.com
PUBLIC_URL=
# Extra names for the LAN certificate, e.g. a local DNS name: photos.lan
TLS_NAMES=

# --- Options ---------------------------------------------------------------
# 1 only while testing (OTP shows in the server window when mail is not set
# up). MUST be 0 for real guests.
DEV_MODE=0
# 1 only when the app sits behind Caddy / Nginx / Cloudflare Tunnel (domain hosting)
TRUST_PROXY=0
# Face match strictness. Higher = fewer wrong photos but may miss some (0.30-0.45).
# MATCH_THRESHOLD=0.363
SESSION_HOURS=2
# 1 = one general guest link for all dated albums (guest picks a date range).
PORTAL=1
# Size at which photos are searched for faces. 1280 is about a third faster
# but can miss small faces in group photos.
# SCAN_SIDE=1600
# Photos scanned at the same time (empty = chosen from the PC's processor).
# SCAN_WORKERS=4
# Google Drive photos read at the same time while scanning.
# DRIVE_WORKERS=8
